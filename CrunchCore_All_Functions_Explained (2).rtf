{\pard\sb240\sa120\b\fs32\cf2 3. CrunchSumK1G0\par}
{\pard\sb120\b\fs24 Purpose: Sum by Key (no groups) - Participant-Level Totals\par}

{\pard\sb120\b\fs22 Function Signature:\par}
{\pard\li720\f1\fs18
private static void CrunchSumK1G0(CrunchLayout layout, ICrunchInputReader reader, ICrunchSumOutputWriter writer)\par}

{\pard\sb120\b\fs22 Parameters:\par}
{\pard\li720\sb60
\bullet  {\b layout}: Defines K=1, GroupCount=0\par
\bullet  {\b reader}: Reads participant data (MUST be sorted by key)\par
\bullet  {\b writer}: Writes one row per unique key\par}

{\pard\sb120\b\fs22 Input Data Structure:\par}
{\pard\li720\sb60
{\b k[0]} - Key value (e.g., participant ID, plan ID)\par
{\b g[][]} - Empty (no grouping)\par
{\b d[]} - Dummy columns\par
{\b v[]} - Value columns (monthly balances, transactions, etc.)\par}

{\pard\sb120\b\fs22 Output Structure:\par}
{\pard\li720\sb60
{\b ki[0]} - Always 0 (key index placeholder)\par
{\b kv[0]} - The actual key value\par
{\b gi[]} - Empty\par
{\b gv[]} - Empty\par
{\b DummySum[]} - Sum of dummy columns for this key\par
{\b ValueSum[]} - Sum of value columns for this key\par}

{\pard\sb120\b\fs22\cf3 Example:\par}
{\pard\sb60\b Input Data (Sorted by Key - Participant ID):\par}
{\pard\li720\f1\fs18
Row 1: k=[12345], v=[1000.00, 500.00], d=[1]\par
Row 2: k=[12345], v=[1100.00, 520.00], d=[1]  (same participant, next month)\par
Row 3: k=[12345], v=[1200.00, 540.00], d=[1]  (same participant, next month)\par
Row 4: k=[67890], v=[2000.00, 800.00], d=[1]  (different participant)\par
Row 5: k=[67890], v=[2100.00, 820.00], d=[1]\par}

{\pard\sb60\b Array Index Meanings:\par}
{\pard\li720\fs20
{\b k[0]} = Participant ID or Plan ID (the grouping key)\par
{\b v[0]} = Balance column\par
{\b v[1]} = Contribution column\par
{\b d[0]} = Month count (usually 1 per row)\par}

{\pard\sb60\b Processing Algorithm:\par}
{\pard\li720\fs20
1. Read first row, store currKey = k[0]\par
2. Accumulate values while k[0] == currKey\par
3. When k[0] changes:\par
   - Write accumulated totals for currKey\par
   - Reset accumulator\par
   - Update currKey = new k[0]\par
4. Continue until end of file\par}

{\pard\sb60\b Output (2 rows, one per participant):\par}
{\pard\li720\f1\fs18
ki=[0], kv=[12345], gi=[], gv=[]\par
  DummySum=[3], ValueSum=[3300.00, 1560.00]\par
  Meaning: Participant 12345, 3 months, totals\par
\par
ki=[0], kv=[67890], gi=[], gv=[]\par
  DummySum=[2], ValueSum=[4100.00, 1620.00]\par
  Meaning: Participant 67890, 2 months, totals\par}

{\pard\sb60\b\cf4 Critical Requirement:\par}
{\pard\li720\fs20\cf4
Input data MUST be sorted by key column. If not sorted, results will be incorrect.\par
The algorithm assumes consecutive rows with same key are together.\par}

\page

{\pard\sb240\sa120\b\fs32\cf2 4. CrunchSumK1G1\par}
{\pard\sb120\b\fs24 Purpose: Sum by Key with 1 Dimension - Participant Totals by Segments\par}

{\pard\sb120\b\fs22 Function Signature:\par}
{\pard\li720\f1\fs18
private static void CrunchSumK1G1(CrunchLayout layout, ICrunchInputReader reader, ICrunchSumOutputWriter writer)\par}

{\pard\sb120\b\fs22 Parameters:\par}
{\pard\li720\sb60
\bullet  {\b layout}: Defines K=1, GroupCount=1 (e.g., G1=3 columns)\par
\bullet  {\b reader}: Reads participant data sorted by key\par
\bullet  {\b writer}: Writes multiple rows per key (one per group combination)\par}

{\pard\sb120\b\fs22 Input Data Structure:\par}
{\pard\li720\sb60
{\b k[0]} - Participant ID or Plan ID\par
{\b g[0][]} - Group dimension 0 (e.g., 3 values for fund categories)\par
{\b d[]} - Dummy columns\par
{\b v[]} - Value columns\par}

{\pard\sb120\b\fs22 Output Structure:\par}
{\pard\li720\sb60
{\b ki[0]} - Always 0\par
{\b kv[0]} - The participant/plan key\par
{\b gi[0]} - Which column in dimension 0 (0, 1, 2)\par
{\b gv[0]} - Value from that column (fund category code)\par
{\b DummySum[]} - Sum for this key + group combo\par
{\b ValueSum[]} - Sum for this key + group combo\par}

{\pard\sb120\b\fs22\cf3 Example:\par}
{\pard\sb60\b Use Case: Plan-level deferrals by fund category\par}
{\pard\li720\fs20
G1 has 3 columns representing fund categories:\par
  g[0][0] = Pre-tax deferral category\par
  g[0][1] = Roth deferral category\par
  g[0][2] = After-tax deferral category\par}

{\pard\sb60\b Input Data:\par}
{\pard\li720\f1\fs18
Row 1: k=[PLN001], g[0]=[1,0,0], v=[50000.00], d=[1]\par
  Plan PLN001, pre-tax only (category 1), no Roth, no after-tax\par
\par
Row 2: k=[PLN001], g[0]=[1,0,0], v=[52000.00], d=[1]\par
  Same plan, next month\par
\par
Row 3: k=[PLN002], g[0]=[1,2,0], v=[30000.00], d=[1]\par
  Plan PLN002, pre-tax category 1, Roth category 2\par
\par
Row 4: k=[PLN002], g[0]=[1,2,0], v=[31000.00], d=[1]\par
  Same plan, next month\par}

{\pard\sb60\b Array Index Meanings:\par}
{\pard\li720\fs20
{\b g[0][i]} = Fund category code for column i (0=none, 1-9=category codes)\par
{\b sum[i][m]} where:\par
  i = column index (0, 1, 2)\par
  m = category value (0-9)\par}

{\pard\sb60\b Processing:\par}
{\pard\li720\fs20
For each key (plan):\par
1. Accumulate in sum[i][g[0][i]] for all rows with same key\par
2. When key changes, write output for ALL non-zero combinations\par
3. Reset accumulators and move to next key\par}

{\pard\sb60\b Output (6 rows - 3 per plan):\par}
{\pard\li720\f1\fs18
ki=[0], kv=[PLN001], gi=[0], gv=[1], DummySum=[2], ValueSum=[102000.00]\par
  Plan PLN001, pre-tax column, category 1, 2 months\par
\par
ki=[0], kv=[PLN001], gi=[1], gv=[0], DummySum=[2], ValueSum=[102000.00]\par
  Plan PLN001, Roth column, category 0 (no Roth), 2 months\par
\par
ki=[0], kv=[PLN001], gi=[2], gv=[0], DummySum=[2], ValueSum=[102000.00]\par
  Plan PLN001, after-tax column, category 0 (none), 2 months\par
\par
ki=[0], kv=[PLN002], gi=[0], gv=[1], DummySum=[2], ValueSum=[61000.00]\par
  Plan PLN002, pre-tax column, category 1\par
\par
ki=[0], kv=[PLN002], gi=[1], gv=[2], DummySum=[2], ValueSum=[61000.00]\par
  Plan PLN002, Roth column, category 2\par
\par
ki=[0], kv=[PLN002], gi=[2], gv=[0], DummySum=[2], ValueSum=[61000.00]\par
  Plan PLN002, after-tax column, category 0 (none)\par}

{\pard\sb60\b Output Pattern:\par}
{\pard\li720\fs20
For each unique key: {\b GroupColumns[0]} rows output\par
In this case: 3 rows per plan (one for each fund category column)\par}

