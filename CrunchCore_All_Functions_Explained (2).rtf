{\pard\sb240\sa120\b\fs32\cf2 5. CrunchBoxK0G0\par}
{\pard\sb120\b\fs24 Purpose: Percentile Distribution (no keys, no groups)\par}

{\pard\sb120\b\fs22 Function Signature:\par}
{\pard\li720\f1\fs18
private static void CrunchBoxK0G0(CrunchLayout layout, CrunchHeap heap, CrunchInputFileReader reader, ICrunchBoxOutputWriter writer)\par}

{\pard\sb120\b\fs22 Parameters:\par}
{\pard\li720\sb60
\bullet  {\b layout}: Defines K=0, GroupCount=0, Mode=Box\par
\bullet  {\b heap}: In-memory storage of all data\par
\bullet  {\b reader}: Reads ONE COLUMN at a time from binary file\par
\bullet  {\b writer}: Writes percentiles for each value column\par}

{\pard\sb120\b\fs22 Input Data Structure:\par}
{\pard\li720\sb60
{\b k} (int) - Column index being processed\par
{\b data[]} (double array) - All values for this column across all participants\par}

{\pard\sb120\b\fs22 Output Structure:\par}
{\pard\li720\sb60
{\b ki[]} - Empty\par
{\b kv[]} - Empty\par
{\b gi[]} - Empty\par
{\b gv[]} - Empty\par
{\b vi} (int) - Value column index\par
{\b vq} (int) - Count of non-null values\par
{\b vs[]} (double array) - 7 percentiles: [P05, P10, P25, P50, P75, P90, P95]\par}

{\pard\sb120\b\fs22\cf3 Example:\par}
{\pard\sb60\b Input Data (1 value column, 10 participants):\par}
{\pard\li720\f1\fs18
Column k=0 (3-month return):\par
data = [0.02, 0.05, 0.03, 0.08, 0.04, 0.06, 0.01, 0.07, 0.05, 0.09]\par}

{\pard\sb60\b Array Index Meanings:\par}
{\pard\li720\fs20
{\b data[r]} = Value for row r (participant r)\par
{\b vs[0]} = 5th percentile\par
{\b vs[1]} = 10th percentile\par
{\b vs[2]} = 25th percentile (Q1)\par
{\b vs[3]} = 50th percentile (Median)\par
{\b vs[4]} = 75th percentile (Q3)\par
{\b vs[5]} = 90th percentile\par
{\b vs[6]} = 95th percentile\par}

{\pard\sb60\b Processing Algorithm:\par}
{\pard\li720\fs20
For each value column:\par
1. Read entire column into data[]\par
2. Count non-null values -> vq\par
3. Extract non-null values into va[]\par
4. Compute percentiles using CrunchStats.SummaryL3\par
5. Write single output row with percentiles\par}

{\pard\sb60\b Output (1 row per value column):\par}
{\pard\li720\f1\fs18
ki=[], kv=[], gi=[], gv=[]\par
vi=0, vq=10\par
vs=[0.012, 0.019, 0.028, 0.045, 0.068, 0.084, 0.088]\par
  P05=0.012 (5% of participants have returns <= 1.2%)\par
  P10=0.019 (10% <= 1.9%)\par
  P25=0.028 (25% <= 2.8%)\par
  P50=0.045 (50% <= 4.5% - MEDIAN)\par
  P75=0.068 (75% <= 6.8%)\par
  P90=0.084 (90% <= 8.4%)\par
  P95=0.088 (95% <= 8.8%)\par}

{\pard\sb60\b Output Volume:\par}
{\pard\li720\fs20
For 16 value columns: exactly 16 output rows (one per column)\par}

\page

{\pard\sb240\sa120\b\fs32\cf2 6. CrunchBoxK0G2\par}
{\pard\sb120\b\fs24 Purpose: Percentile Distribution with 2D Grouping\par}

{\pard\sb120\b\fs22 Function Signature:\par}
{\pard\li720\f1\fs18
private static void CrunchBoxK0G2(CrunchLayout layout, CrunchHeap heap, CrunchInputFileReader reader, ICrunchBoxOutputWriter writer)\par}

{\pard\sb120\b\fs22 Parameters:\par}
{\pard\li720\sb60
\bullet  {\b layout}: Defines K=0, GroupCount=2 (e.g., G1=3, G2=18)\par
\bullet  {\b heap}: Contains Group[0][i][r] and Group[1][j][r] for all rows\par
\bullet  {\b reader}: Reads one value column at a time\par
\bullet  {\b writer}: Writes percentiles for each (column_combo, value_pair)\par}

{\pard\sb120\b\fs22 Input Data Structure:\par}
{\pard\li720\sb60
{\b k} - Value column index\par
{\b data[r]} - Value for row r\par
{\b heap.Group[0][i][r]} - Dimension 0 column i value for row r\par
{\b heap.Group[1][j][r]} - Dimension 1 column j value for row r\par}

{\pard\sb120\b\fs22 Output Structure:\par}
{\pard\li720\sb60
{\b gi[0]} - Column index in dimension 0 (0, 1, 2 for mkt columns)\par
{\b gi[1]} - Column index in dimension 1 (0-17 for pop columns)\par
{\b gv[0]} - Group value from dimension 0 (market segment code)\par
{\b gv[1]} - Group value from dimension 1 (population segment code)\par
{\b vi} - Value column index\par
{\b vq} - Count of participants in this bucket\par
{\b vs[]} - 7 percentiles for this bucket\par}

{\pard\sb120\b\fs22\cf3 Example:\par}
{\pard\sb60\b Input Data:\par}
{\pard\li720\f1\fs18
G1=3 (mkt_01, mkt_02, mkt_03), G2=2 (pop_01, pop_02) - simplified\par
1 value column (balance)\par
\par
Participant data stored in heap:\par
Row 0: Group[0][0][0]=2, Group[0][1][0]=1, Group[0][2][0]=3,\par
       Group[1][0][0]=1, Group[1][1][0]=0\par
       data[0] = 5000.00\par
\par
Row 1: Group[0][0][1]=2, Group[0][1][1]=1, Group[0][2][1]=3,\par
       Group[1][0][1]=1, Group[1][1][1]=0\par
       data[1] = 3000.00\par
\par
Row 2: Group[0][0][2]=3, Group[0][1][2]=2, Group[0][2][2]=1,\par
       Group[1][0][2]=2, Group[1][1][2]=1\par
       data[2] = 7000.00\par}

{\pard\sb60\b Array Index Meanings:\par}
{\pard\li720\fs20
{\b ordinal} = i * GroupColumns[1] + j\par
  Maps 2D (i,j) to 1D index\par
  Example: i=1, j=5 -> ordinal = 1*18+5 = 23\par
\par
{\b vq[ordinal][m][n]} = Count for column combo ordinal, values (m,n)\par
{\b vi[ordinal][m][n]} = Current insertion index\par
{\b va[m][n][]} = Array of values for this bucket\par}

{\pard\sb60\b Processing Algorithm:\par}
{\pard\li720\fs20
For each value column k:\par
  For each column combination (i,j):\par
    1. Count participants in each (m,n) bucket\par
    2. Allocate va[m][n] arrays sized by counts\par
    3. Populate va by scanning data[] and Group arrays\par
    4. Compute percentiles for each bucket with count>0\par
    5. Write output row\par}

{\pard\sb60\b Memory Access Pattern:\par}
{\pard\li720\f1\fs18
For row r and column combo (i=1, j=3):\par
  m = heap.Group[0][1][r]  // value from mkt_02\par
  n = heap.Group[1][3][r]  // value from 4th pop column\par
  va[m][n][index] = data[r]\par}

{\pard\sb60\b Output Example (Partial):\par}
{\pard\li720\f1\fs18
gi=[0,0], gv=[2,1], vi=0, vq=2\par
vs=[3000.00, 3200.00, 3500.00, 4000.00, 4500.00, 4800.00, 5000.00]\par
  Meaning: mkt_01=2 AND pop_01=1, balance column,\par
           2 participants, their percentiles\par
\par
gi=[1,0], gv=[1,1], vi=0, vq=2\par
vs=[3000.00, 3200.00, 3500.00, 4000.00, 4500.00, 4800.00, 5000.00]\par
  Meaning: mkt_02=1 AND pop_01=1, same 2 participants\par
\par
gi=[0,0], gv=[3,2], vi=0, vq=1\par
vs=[7000.00, 7000.00, 7000.00, 7000.00, 7000.00, 7000.00, 7000.00]\par
  Meaning: mkt_01=3 AND pop_01=2, 1 participant,\par
           all percentiles equal (single value)\par}

{\pard\sb60\b Output Volume:\par}
{\pard\li720\fs20
For G1=3, G2=18, V=16:\par
\bullet  54 column combinations (3 \'d7 18)\par
\bullet  Each combo processes all (m,n) value pairs\par
\bullet  16 value columns\par
\bullet  Typical output: 10,000 to 500,000 rows\par}

\page

{\pard\sb240\sa120\b\fs32\cf2 7. CrunchBoxK1G1\par}
{\pard\sb120\b\fs24 Purpose: Percentiles by Key with 1 Dimension\par}

{\pard\sb120\b\fs22 Function Signature:\par}
{\pard\li720\f1\fs18
private static void CrunchBoxK1G1(CrunchLayout layout, CrunchHeap heap, CrunchInputFileReader reader, ICrunchBoxOutputWriter writer)\par}

{\pard\sb120\b\fs22 Parameters:\par}
{\pard\li720\sb60
\bullet  {\b layout}: Defines K=1, GroupCount=1\par
\bullet  {\b heap}: Contains Key[0][r] and Group[0][i][r]\par
\bullet  {\b reader}: Reads value columns\par
\bullet  {\b writer}: Writes percentiles for each (key, group_column, group_value)\par}

{\pard\sb120\b\fs22 Input Data Structure:\par}
{\pard\li720\sb60
{\b heap.Key[0][r]} - Key value for row r (MUST be sorted)\par
{\b heap.Group[0][i][r]} - Group value for column i, row r\par
{\b data[r]} - Value for row r in current column\par}

{\pard\sb120\b\fs22 Output Structure:\par}
{\pard\li720\sb60
{\b ki[0]} - Always 0\par
{\b kv[0]} - The key value (plan ID, participant ID)\par
{\b gi[0]} - Group column index\par
{\b gv[0]} - Group value\par
{\b vi} - Value column index\par
{\b vq} - Count of rows for this key + group combo\par
{\b vs[]} - 7 percentiles\par}

{\pard\sb120\b\fs22\cf3 Example:\par}
{\pard\sb60\b Use Case: Plan-level deferral distributions by fund category\par}
{\pard\li720\fs20
G1=3 fund categories, K=1 plan ID\par
Compute percentiles of participant deferrals within each plan-category\par}

{\pard\sb60\b Input Data in Heap:\par}
{\pard\li720\f1\fs18
Plan PLN001 (rows 0-49, 50 participants):\par
  Row 0-49: Key[0][r]=PLN001\par
  Group[0][0][0-49] = pre-tax category (1,1,2,1,3,...)\par
  Group[0][1][0-49] = Roth category (0,2,2,0,2,...)\par
  Group[0][2][0-49] = after-tax category (0,0,0,0,1,...)\par
\par
Plan PLN002 (rows 50-99, 50 participants):\par
  Row 50-99: Key[0][r]=PLN002\par
  Group[0][0][50-99] = pre-tax category\par
  ...\par
\par
Value column k=0 (deferral amount):\par
  data[0-49] = PLN001 participant deferrals\par
  data[50-99] = PLN002 participant deferrals\par}

{\pard\sb60\b Array Index Meanings:\par}
{\pard\li720\fs20
{\b rmin[b]} = First row for key block b\par
{\b rmax[b]} = Last row + 1 for key block b\par
{\b vq[i][m]} = Count for group column i, value m, current key\par
{\b va[m][]} = Array of values for group value m\par}

{\pard\sb60\b Processing Algorithm:\par}
{\pard\li720\fs20
1. Scan heap to find key boundaries (rmin, rmax)\par
2. For each value column:\par
   For each key block b:\par
     For each group column i:\par
       a. Count values by group value m\par
       b. Allocate va[m] arrays\par
       c. Populate va from data[rmin[b]:rmax[b]]\par
       d. Compute percentiles for each m\par
       e. Write output rows\par}

{\pard\sb60\b Output Example:\par}
{\pard\li720\f1\fs18
ki=[0], kv=[PLN001], gi=[0], gv=[1], vi=0, vq=30\par
vs=[50.00, 100.00, 200.00, 350.00, 500.00, 700.00, 900.00]\par
  Plan PLN001, pre-tax column, category 1,\par
  30 participants in this category, their deferral percentiles\par
\par
ki=[0], kv=[PLN001], gi=[0], gv=[2], vi=0, vq=15\par
vs=[100.00, 150.00, 250.00, 400.00, 550.00, 750.00, 950.00]\par
  Plan PLN001, pre-tax column, category 2, 15 participants\par
\par
ki=[0], kv=[PLN001], gi=[1], gv=[2], vi=0, vq=25\par
vs=[75.00, 120.00, 225.00, 375.00, 525.00, 725.00, 925.00]\par
  Plan PLN001, Roth column, category 2, 25 participants\par}

{\pard\sb60\b Output Pattern:\par}
{\pard\li720\fs20
For each unique key:\par
  For each group column (3 in this example):\par
    For each unique group value in that column:\par
      One output row with percentiles\par}

